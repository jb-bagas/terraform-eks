# Copy this file to bootstrap/terraform.tfvars and set a globally unique name.
region       = "us-east-1"
project_name = "eks-platform"
bucket_name  = "your-org-eks-platform-tfstate"

# Optional: create a separate bucket for state-bucket access logs.
# S3 server access logging cannot target the source bucket.
# log_bucket_name = "your-org-eks-platform-tfstate-logs"
