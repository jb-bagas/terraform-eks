# Terraform local files
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.json
/tfplan
/plan.txt
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Ignore real variable files (may contain secrets)
*.tfvars
*.tfvars.json

# Ignore real backend config files (contain S3 bucket names, etc.)
*.tfbackend

# Keep the examples
!vars/*.tfvars.example
!backend/*.tfbackend.example
!bootstrap/terraform.tfvars.example

# Local Kubernetes / credentials files
kubeconfig
kubeconfig.*
*.pem
.env
.env.*

# OS / IDE files
.DS_Store
.idea/
.vscode/
*.swp
