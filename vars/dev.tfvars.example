# ─────────────────────────────────────────────
# GLOBAL CONFIGURATION
# ─────────────────────────────────────────────
environment = "dev"
aws_region      = "us-east-1"

# ─────────────────────────────────────────────
# NETWORKING (VPC)
# ─────────────────────────────────────────────
vpc_cidr        = "10.0.0.0/16"
availability_zones             = ["us-east-1a", "us-east-1b", "us-east-1c"]

# ─────────────────────────────────────────────
# EKS CLUSTER ACCESS
# ─────────────────────────────────────────────
# Optional: Add your IAM user/role ARN here to gain cluster admin access
# Example: "arn:aws:iam::123456789012:role/DevOps-Admin"
admin_role_arn = "" 

# ─────────────────────────────────────────────
# FEATURE FLAGS (Toggle Add-ons On/Off)
# ─────────────────────────────────────────────
enable_alb_controller     = true
enable_secrets_csi        = true
enable_ebs_csi            = true
enable_observability      = true
enable_cluster_autoscaler = true
enable_metrics_server     = true

# ─────────────────────────────────────────────
# EKS MANAGED NODE GROUPS
# ─────────────────────────────────────────────
node_groups = {
  # General purpose node group for your applications
  general = {
    instance_types = ["t3.medium"] # Cost-effective for dev
    disk_size      = 50
    ami_type       = "AL2023_x86_64_STANDARD"
    capacity_type  = "SPOT"        # Huge cost savings for dev (up to 70% off)
    min_size       = 1
    max_size       = 3
    desired_size   = 1
    labels = {
      role        = "general"
      environment = "dev"
    }
    taints = null # No taints for general workloads
  }

  # Optional: Dedicated node group for system add-ons (ALB, CSI, etc.)
  # Uncomment the block below if you want to isolate system workloads
  # system = {
  #   instance_types = ["t3.small"]
  #   disk_size      = 30
  #   ami_type       = "AL2023_x86_64_STANDARD"
  #   capacity_type  = "ON_DEMAND" # Keep critical add-ons on stable nodes
  #   min_size       = 1
  #   max_size       = 2
  #   desired_size   = 1
  #   labels = {
  #     role = "system"
  #   }
  #   taints = [
  #     {
  #       key    = "CriticalAddonsOnly"
  #       value  = "true"
  #       effect = "NO_SCHEDULE"
  #     }
  #   ]
  # }
}